# Local development settings. On a runner these come from the Action's inputs
# (see action.yml); this file is for driving src/actionMain.ts by hand.
# CONTRIBUTING.md walks through a full local run.

# The API key, whichever provider you run. Drives test-plan generation AND
# browser step execution/judging. GREENLIGHT_MODEL picks the provider; this is
# the key for it. There is no provider-specific alternative — one key, one
# place, so it can never disagree with the provider you selected.
GREENLIGHT_LLM_API_KEY=

# Which model runs, as "provider/model". Native providers: anthropic, openai,
# google. OpenAI-compatible hosts: fireworks, together, openrouter. The model id
# is whatever the provider calls it. Required: the provider prefix is never
# guessed, so unset (or unprefixed) means no run.
GREENLIGHT_MODEL=
# Optional: a separate model for driving/judging browser steps (Stagehand
# act/extract). Falls back to GREENLIGHT_MODEL.
# GREENLIGHT_EXECUTOR_MODEL=
# Optional: model that re-judges an item from a screenshot when the DOM alone
# can't settle the expectation. Unset picks a model on the provider you already
# run: the executor model on anthropic/openai/google, a vision-capable model on
# fireworks. On together/openrouter it falls back to the executor model as well,
# but a judge we picked rather than one you named can only pass an item, never
# fail it; name a vision model here for a judge with the final word. "off"
# disables it anywhere.
# GREENLIGHT_VISUAL_JUDGE_MODEL=
# Testing: set to 1 to skip the plan model and drive the pipeline from
# src/mockPlan.ts (deterministic plan for validating preview + browser). Unset
# = real model.
# GREENLIGHT_MOCK_PLAN=1

# Vercel preview. Secret from Vercel → Settings → Deployment Protection →
# "Protection Bypass for Automation". Only needed if previews are protected;
# leave blank for public ones.
VERCEL_AUTOMATION_BYPASS_SECRET=
# Max ms to wait for a preview to build before staying silent (default 300000).
# PREVIEW_TIMEOUT_MS=

# Run the browser on this machine: a real Chrome, driven by Stagehand. Required
# for a local run. Without it execution is skipped, and the run stops after the
# test plan. The Action sets it on the runner.
GREENLIGHT_LOCAL_BROWSER=1
# Max browser sessions at once, when several PRs are in flight in one process.
# Each one is a real Chrome, so treat this as a memory cap. Default 3.
# MAX_CONCURRENT_SESSIONS=

# Session recording (rrweb). Set to a directory to record the browser run and
# write a self-contained replay.html there; leave blank to record nothing. The
# Action sets it and uploads the result as a workflow artifact.
# GREENLIGHT_REPLAY_DIR=./greenlight-replay
# Images are embedded in the replay by default, so it renders for viewers
# without preview access and after the preview is torn down. Set to 0 to link
# them by URL instead — much smaller files, needs a reachable preview to view.
# GREENLIGHT_REPLAY_INLINE_IMAGES=0

# Run the local browser headless. Unset = headed, so you can watch a plan run.
# The Action sets this, since a runner has no display.
# GREENLIGHT_HEADLESS=1

# Phase-by-phase timing logs, to localize where a run stalls. Very noisy.
# GREENLIGHT_DEBUG=1
