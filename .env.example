# GitHub App credentials (see README "Register the GitHub App")
APP_ID=
WEBHOOK_SECRET=
# Path to the private key .pem downloaded from the App settings page
PRIVATE_KEY_PATH=./greenlight.private-key.pem

# smee.io channel URL (open https://smee.io/new to mint one)
SMEE_URL=

# Fireworks API key for test-plan generation (https://app.fireworks.ai/settings/users/api-keys)
FIREWORKS_API_KEY=
# Any Fireworks model id (default: accounts/fireworks/models/kimi-k2p6)
# GREENLIGHT_MODEL=
# Testing: set to 1 to skip Fireworks and drive the pipeline from
# src/mockPlan.ts (deterministic plan for validating preview + browser). Unset
# = real model.
# GREENLIGHT_MOCK_PLAN=1

# Vercel preview (Phase 3). Both optional.
# Secret from Vercel → Settings → Deployment Protection → "Protection Bypass for
# Automation". Only needed if previews are protected; leave blank for public ones.
# VERCEL_AUTOMATION_BYPASS_SECRET=
# Max ms to wait for a preview to build before staying silent (default 300000).
# PREVIEW_TIMEOUT_MS=

PORT=3000
