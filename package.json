{
  "name": "greenlight",
  "version": "0.1.0",
  "private": true,
  "description": "AI PR test bot — GitHub App that tests Vercel previews of Next.js PRs",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "smee": "node --env-file=.env scripts/smee.mjs",
    "typecheck": "tsc --noEmit"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.12",
    "@browserbasehq/stagehand": "^3.7.0",
    "@octokit/app": "^16.1.2",
    "@octokit/webhooks": "^14.2.0",
    "ai": "^7.0.29",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "playwright-core": "^1.61.1",
    "smee-client": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}