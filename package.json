{
  "name": "greenlight",
  "version": "1.0.0",
  "private": true,
  "description": "Github Action that infers what a PR is meant to do and tests its Vercel preview in a real browser",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "preversion": "pnpm typecheck",
    "version": "node scripts/pin-readme-version.mjs && git add README.md",
    "postversion": "git push --follow-tags"
  },
  "packageManager": "pnpm@10.1.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4",
    "@ai-sdk/google": "^4",
    "@ai-sdk/openai": "^4",
    "@ai-sdk/openai-compatible": "^3.0.12",
    "@browserbasehq/stagehand": "^3.7.0",
    "@octokit/core": "^7.0.6",
    "ai": "^7.0.29",
    "dotenv": "^17.4.2",
    "playwright-core": "^1.61.1",
    "rrweb": "^2.1.1",
    "rrweb-player": "^2.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
